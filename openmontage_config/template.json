{
  "project": {
    "title": "Clockwork Repository Animation",
    "width": 1280,
    "height": 720,
    "fps": 30,
    "aspect_ratio": "16:9"
  },
  "tracks": [
    {
      "name": "video_layer",
      "type": "video",
      "z_index": 1
    },
    {
      "name": "dialogue_audio",
      "type": "audio",
      "z_index": 2
    },
    {
      "name": "subtitle_layer",
      "type": "subtitle",
      "z_index": 3,
      "style": {
        "font_size": 28,
        "font_color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width": 2,
        "position": "bottom"
      }
    }
  ]
}
